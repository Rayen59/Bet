# GEMINI_API_KEY: Optional Gemini API key (unused when AI picks are disabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted (Vercel / Render / Cloud Run).
APP_URL="MY_APP_URL"

# PostgreSQL Connection (Cloud SQL / Render Postgres / Neon / Supabase)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your-postgres-password"
SQL_DB_NAME="sportzone"
SQL_SSL="false"

# JWT_SECRET: Secret for session authentication tokens (change in production).
JWT_SECRET="sportzone-dev-secret-change-in-prod"

# RAPIDAPI_SPORTS_KEY: Optional RapidAPI key; SPORTZONE syncs LiveScore + ESPN live feeds directly.
RAPIDAPI_SPORTS_KEY=""
